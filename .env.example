# CPF.CNPJ: URL oficial com os marcadores {token}, {package} e {cpf}.
# Nunca exponha esta URL ou o token no navegador.
CPF_PROVIDER_URL=https://api.cpfcnpj.com.br/{token}/{package}/{cpf}
CPF_PROVIDER_TOKEN=
CPF_PROVIDER_PACKAGE=1
CPF_PROVIDER_METHOD=GET

# URL pública do Typebot, configurada somente quando o bot estiver pronto.
NEXT_PUBLIC_TYPEBOT_URL=
NEXT_PUBLIC_CPF_FLOW_ENABLED=false
CPF_FLOW_ENABLED=false
TYPEBOT_FLOW_ENABLED=false

# Upstash Redis REST credentials (server-side only). Create a database in Upstash.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
